<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- External ESP32-CAM MJPEG Stream Display -->
    <ImageView
        android:id="@+id/esp32StreamView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:background="@color/black"
        android:visibility="gone" />

    <com.blindcap.app.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Bar: Source Switcher, Stream Settings & Face Contacts Setup -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingBottom="8dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="#CC000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnSourceToggle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.2"
                android:text="Source: Phone"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnStreamSettings"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="ESP32 IP"
                android:textSize="12sp"
                android:backgroundTint="#444444"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnFaces"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.1"
                android:layout_marginStart="6dp"
                android:text="Faces"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#00897B"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtStreamStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textSize="11sp"
            android:textColor="#00FFCC"
            android:gravity="center"
            android:visibility="gone"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Accessible Quick Action Buttons for Blind / Low-Vision Users -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnOcr"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="READ TEXT (OCR)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#0088FF"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnScene"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="SCENE SUMMARY"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#00AA44"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>