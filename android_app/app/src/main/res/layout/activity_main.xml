<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- LAYER 1: Full-Screen Live Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- LAYER 1B: Alternate ESP32 Smart Cap Stream View -->
    <ImageView
        android:id="@+id/esp32StreamView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- LAYER 2: Live AI HUD, Telemetry & Bounding Box Overlay -->
    <com.blindcap.app.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- LAYER 3: Minimalist Pixel Center Reticle Focus Ring -->
    <View
        android:id="@+id/centerReticle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/reticle_circle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TOP FLOATING PILL BAR (Google Pixel Camera Style) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_pixel_top_pill"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:contentDescription="Open Settings"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnFaceManager"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_tools"
            android:contentDescription="Manage Face Contacts"
            app:tint="#FF80AB"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/txtModeStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="COMBINED MODE"
            android:textColor="#E6E1E5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:paddingHorizontal="8dp" />

        <TextView
            android:id="@+id/txtSourceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/mode_pill_unselected"
            android:text="Phone Camera"
            android:textColor="#00FFCC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp" />
    </LinearLayout>

    <!-- BOTTOM PIXEL CAMERA CONTROL ISLAND -->
    <LinearLayout
        android:id="@+id/bottomControlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="18dp"
        android:paddingBottom="42dp"
        android:background="@drawable/bg_pixel_bottom_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Dynamic Mode Carousel (Stock Pixel Camera Style) -->
        <HorizontalScrollView
            android:id="@+id/modeCarouselScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/modeCarouselLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="24dp">

                <TextView
                    android:id="@+id/btnPillCombined"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Combined"
                    android:textColor="#1F2421"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/mode_pill_selected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="7dp"
                    android:layout_marginHorizontal="4dp" />

                <TextView
                    android:id="@+id/btnPillObjectNav"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Object"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/mode_pill_unselected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="7dp"
                    android:layout_marginHorizontal="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnPillOcr"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OCR"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/mode_pill_unselected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="7dp"
                    android:layout_marginHorizontal="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnPillCurrency"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Banknote"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/mode_pill_unselected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="7dp"
                    android:layout_marginHorizontal="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnPillColor"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/mode_pill_unselected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="7dp"
                    android:layout_marginHorizontal="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnPillBarcode"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Barcode"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/mode_pill_unselected"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="7dp"
                    android:layout_marginHorizontal="4dp"
                    android:visibility="gone" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Primary Shutter Action Row (Google Pixel Camera Style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="36dp">

            <!-- Left Button: Quick Inspect / Scene Summary -->
            <ImageButton
                android:id="@+id/btnSceneSummary"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_pixel_circle_btn"
                android:src="@drawable/ic_scene"
                android:contentDescription="Scene Summary"
                app:tint="#E0E6ED" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Center Large Shutter Button (Stock Pixel Camera Shutter) -->
            <ImageButton
                android:id="@+id/btnShutter"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:background="@drawable/shutter_button_bg"
                android:contentDescription="Primary Camera Shutter" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Right Button: Assistant Tools -->
            <ImageButton
                android:id="@+id/btnTools"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_pixel_circle_btn"
                android:src="@drawable/ic_tools"
                android:contentDescription="Open Assistant Tools"
                app:tint="#E0E6ED" />

        </LinearLayout>
    </LinearLayout>

    <!-- LAYER 4: Beautified Voice Assistant Interactive Overlay -->
    <FrameLayout
        android:id="@+id/voiceAssistantOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0A0D11"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/bg_voice_card"
            android:orientation="vertical"
            android:padding="24dp"
            android:elevation="12dp"
            android:gravity="center_horizontal">

            <!-- Glowing Pulsing Mic Icon -->
            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_mic_glow"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🎙️"
                    android:textSize="36sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtVoiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Listening... Speak now"
                android:textColor="#00FFCC"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtVoiceTranscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Speak: 'What color is this', 'What note is this', 'Describe scene', or 'Read text'"
                android:textColor="#E0E6ED"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="18dp" />

            <!-- Answer Readout Box (Populated when action responds) -->
            <LinearLayout
                android:id="@+id/layoutVoiceResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2B323D"
                android:padding="14dp"
                android:visibility="gone"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/txtVoiceResultTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assistant Response"
                    android:textColor="#00FFCC"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/txtVoiceResultBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Quick Suggestions Row with Tasteful Minimal Emojis -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipVoiceColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_voice_chip"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="🎨 Color"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipVoiceCurrency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_voice_chip"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="💵 Banknote"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipVoiceScene"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_voice_chip"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="👁️ Scene"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipVoiceOcr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_voice_chip"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="📖 Read Text"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipVoiceBarcode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_voice_chip"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="🏷️ Barcode"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Close Button -->
            <Button
                android:id="@+id/btnCancelVoice"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Close Assistant"
                android:backgroundTint="#374151"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
