<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1C2025"
    android:padding="20dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#4D8A93A0"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Assistant Tools"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select an AI tool to analyze the current camera view:"
        android:textColor="#9EABB8"
        android:textSize="13sp"
        android:paddingBottom="16dp" />

    <!-- Tool 1: Face Recognition & Enrolment -->
    <LinearLayout
        android:id="@+id/cardToolFaceEnroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_pixel_tool"
        android:padding="16dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:background="@drawable/bg_voice_chip"
            android:text="👤"
            android:textSize="22sp"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Face Recognition"
                android:textColor="#FF80AB"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Identify known people or enroll new face contacts."
                android:textColor="#9EABB8"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tool 2: Currency / Banknote Reader -->
    <LinearLayout
        android:id="@+id/cardToolCurrency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_pixel_tool"
        android:padding="16dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:background="@drawable/bg_voice_chip"
            android:text="💵"
            android:textSize="22sp"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Indian Rupee Banknote Reader"
                android:textColor="#00FFCC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scans ₹10, ₹20, ₹50, ₹100, ₹200, and ₹500 notes."
                android:textColor="#9EABB8"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tool 3: Color & Light Detector -->
    <LinearLayout
        android:id="@+id/cardToolColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_pixel_tool"
        android:padding="16dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:background="@drawable/bg_voice_chip"
            android:text="🎨"
            android:textSize="22sp"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Color &amp; Brightness Detector"
                android:textColor="#FFD54F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Names the centered color and reports ambient brightness."
                android:textColor="#9EABB8"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tool 4: Barcode & QR Product Scanner -->
    <LinearLayout
        android:id="@+id/cardToolBarcode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_pixel_tool"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:background="@drawable/bg_voice_chip"
            android:text="🏷️"
            android:textSize="22sp"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barcode &amp; QR Product Scanner"
                android:textColor="#64B5F6"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scans grocery barcodes, medicines, and QR codes."
                android:textColor="#9EABB8"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnCancelTools"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Close"
        android:backgroundTint="#343A40"
        android:textColor="#FFFFFF" />

</LinearLayout>
