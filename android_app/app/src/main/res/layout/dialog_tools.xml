<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1C1B1F"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Assistant Tools"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select an on-demand assistive tool to analyze the current view:"
        android:textColor="#CAC4D0"
        android:textSize="13sp"
        android:paddingBottom="16dp" />

    <!-- Tool 1: Currency -->
    <LinearLayout
        android:id="@+id/cardToolCurrency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_mode_bg"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰"
            android:textSize="28sp"
            android:paddingEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Indian Rupee Cash Reader"
                android:textColor="#00FFCC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Identifies ₹10, ₹20, ₹50, ₹100, ₹200, ₹500 banknotes instantly."
                android:textColor="#CAC4D0"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tool 2: Color & Light -->
    <LinearLayout
        android:id="@+id/cardToolColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_mode_bg"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎨"
            android:textSize="28sp"
            android:paddingEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Color &amp; Brightness Detector"
                android:textColor="#FFD54F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Names the color in center view and reports room brightness."
                android:textColor="#CAC4D0"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tool 3: Barcode & QR -->
    <LinearLayout
        android:id="@+id/cardToolBarcode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_mode_bg"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏷️"
            android:textSize="28sp"
            android:paddingEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barcode &amp; QR Product Scanner"
                android:textColor="#64B5F6"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scans grocery barcodes, medicines, and QR codes."
                android:textColor="#CAC4D0"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnCancelTools"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Close"
        android:backgroundTint="#333333"
        android:textColor="#FFFFFF" />

</LinearLayout>
